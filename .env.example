# Copia este archivo como .env y llena los valores del archivo de credenciales
# que descargaste al crear tu instancia en https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tu-password-de-aura
# NEO4J_DATABASE=   (déjalo comentado: se usa la base por defecto de Aura)

# Flask
FLASK_SECRET_KEY=cambia-esta-clave
FLASK_DEBUG=0
