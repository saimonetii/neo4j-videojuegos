digraph M {
  rankdir=LR; bgcolor="white"; nodesep=0.7; ranksep=1.1;
  node [shape=circle, style=filled, fontname="Helvetica", fontsize=10, fixedsize=true, width=1.45, penwidth=1.5];
  edge [fontname="Helvetica", fontsize=9, penwidth=1.3];
  Player [label=<<b>:Player</b><br/><font point-size="8">username (único)<br/>name<br/>country<br/>createdAt</font>>, fillcolor="#c4b5fd", color="#7c3aed"];
  Game [label=<<b>:Game</b><br/><font point-size="8">id (único)<br/>title<br/>year<br/>description</font>>, fillcolor="#7dd3fc", color="#0284c7"];
  Genre [label=<<b>:Genre</b><br/><font point-size="8">name (único)</font>>, fillcolor="#6ee7b7", color="#059669", width=1.15];
  Platform [label=<<b>:Platform</b><br/><font point-size="8">name (único)</font>>, fillcolor="#fde68a", color="#d97706", width=1.15];
  Developer [label=<<b>:Developer</b><br/><font point-size="8">name (único)</font>>, fillcolor="#fda4af", color="#e11d48", width=1.15];
  Player -> Player [label=<<b>FRIEND_OF</b><br/>{since: Date}<br/>(simétrica)>, dir=both, arrowtail=none, color="#7c3aed"];
  Player -> Game [label=<<b>PLAYED</b><br/>{rating: 1-5, hours: Integer}>, color="#334155"];
  Game -> Genre [label=<<b>HAS_GENRE</b>>, color="#059669"];
  Game -> Platform [label=<<b>AVAILABLE_ON</b>>, color="#d97706"];
  Game -> Developer [label=<<b>DEVELOPED_BY</b>>, color="#e11d48"];
}
